{
  "name": "api-migration-autopilot",
  "version": "0.5.0-alpha.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run typecheck && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "eval:assessment": "tsx scripts/evaluate-assessment.ts",
    "audit:production": "node scripts/audit-production-deps.mjs",
    "e2b:build": "tsx scripts/build-e2b-template.ts",
    "e2b:verify": "tsx scripts/verify-e2b-template.ts",
    "openai:verify": "tsx scripts/verify-openai.ts",
    "trigger:dev": "trigger dev --skip-update-check",
    "trigger:deploy": "trigger deploy --skip-update-check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@trigger.dev/sdk": "^4.5.7",
    "drizzle-orm": "0.45.2",
    "e2b": "^2.14.0",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "0.53.0",
    "next": "16.2.12",
    "parse5": "^8.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0",
    "typescript": "5.9.3",
    "unpdf": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@trigger.dev/build": "^4.5.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "trigger.dev": "4.5.7",
    "tsx": "^4.23.1",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "cookie": "0.7.2",
    "engine.io": "6.6.9",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "type": "module"
}
