# Public application URL
APP_BASE_URL=http://localhost:3000

# Local-only signed-in identity. Never set this in production.
ALLOW_DEV_AUTH=true
DEV_USER_EMAIL=founder@example.com
DEV_USER_NAME=Founder
INTERNAL_OPERATOR_EMAILS=

# Artifact envelope encryption. 32 bytes, base64 or hex. Required before any
# patch, validation log, or run manifest can be stored.
ARTIFACT_ENCRYPTION_KEY=

# GitHub Scanner App (metadata:read, contents:read)
GITHUB_SCANNER_APP_ID=
GITHUB_SCANNER_PRIVATE_KEY=
GITHUB_SCANNER_WEBHOOK_SECRET=
GITHUB_SCANNER_SLUG=

# GitHub Patcher App (contents:write, pull_requests:write, checks:read)
GITHUB_PATCHER_APP_ID=
GITHUB_PATCHER_PRIVATE_KEY=
GITHUB_PATCHER_WEBHOOK_SECRET=
GITHUB_PATCHER_SLUG=
GITHUB_SETUP_STATE_SECRET=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_SPEC_MODEL=gpt-5.6-terra
OPENAI_PATCH_MODEL=gpt-5.6-sol

# E2B secure sandbox execution
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_REGISTRY_CIDRS=

# Trigger.dev durable workflows
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_PROJECT_REF=
WORKFLOW_CALLBACK_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=Migration Autopilot <noreply@example.com>

# Optional WorkOS bridge for a future non-Sites deployment
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
